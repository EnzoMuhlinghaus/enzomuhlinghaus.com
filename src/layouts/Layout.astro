---
// Three voices, per Design System v2 §03: Caveat speaks, Special Elite labels,
// JetBrains Mono measures. Nothing else.
import '@fontsource/caveat/500.css';
import '@fontsource/caveat/600.css';
import '@fontsource/caveat/700.css';
import '@fontsource/special-elite/400.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
import ogCard from '../assets/photos/og-card.jpg';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// A purpose-cut 1200×630 landscape crop of the Home spread's mounted print. The
// print itself is portrait and gets center-cropped to mush by social scrapers,
// so the share card is its own asset rather than a reuse of moi.webp.
const ogImage = new URL(ogCard.src, Astro.site);
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
  </head>
  <body>
    <slot />
  </body>
</html>
