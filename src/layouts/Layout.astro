---
// Three voices, per Design System v2 §03: Caveat speaks, Special Elite labels,
// JetBrains Mono measures. Nothing else.
import '@fontsource/caveat/500.css';
import '@fontsource/caveat/600.css';
import '@fontsource/caveat/700.css';
import '@fontsource/special-elite/400.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
import ogCard from '../assets/photos/og-card.jpg';

interface Props {
  title: string;
  description: string;
  /**
   * Absolute canonical URL. Required, and required to be absolute, because the
   * journal and the workbench live on different hostnames — there is no single
   * `site` this can be resolved against. It also doubles as the origin for the
   * other absolute URLs below.
   */
  canonical: string;
  /** Structured data for this page. Serialised into one ld+json block. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Exclude the page from search results (e.g. the 404 page). */
  noindex?: boolean;
}

const { title, description, canonical, jsonLd, noindex } = Astro.props;

// A purpose-cut 1200×630 landscape crop of the Home spread's mounted print. The
// print itself is portrait and gets centre-cropped to mush by social scrapers,
// so the share card is its own asset rather than a reuse of moi.webp. Resolved
// against the canonical so each host advertises a card on its own origin.
const ogImage = new URL(ogCard.src, canonical).href;
const ogImageAlt = 'Enzo, mid-espresso, in a corner bistro';
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content="Enzo Muhlinghaus" />
    <meta name="theme-color" content="#2b231a" />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Enzo Muhlinghaus" />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    {/* Without an explicit card type X renders the link as a bare URL, however
        well-formed the og: tags are. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
