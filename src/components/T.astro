---
// Renders one translated string in the site's current language.
//
// This used to emit both languages as a paired .i18n-en/.i18n-fr span and let
// CSS hide one. That is why every visible phrase appeared twice in the HTML —
// and since fr.ts still holds English for the journal blocks, twice *identically*,
// which reads to a crawler as repetition rather than translation. It now emits
// one string and no wrapper element.
//
// The `{ en, fr }` pair structure, both dictionaries and useMessages() all stay.
// When French comes back it should come back as real /fr/ routes with hreflang
// (see CLAUDE.md) — separate URLs are what search engines want anyway, and this
// component then just reads the active route's language.
import { SITE_LANG } from '../i18n';

interface Props {
  t: { en: string; fr: string };
}

const { t } = Astro.props;
---

{t[SITE_LANG]}
