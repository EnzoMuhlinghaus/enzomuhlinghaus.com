---
// Hand-drawn flag marks (Design System v2 §05 "marginalia"). Deliberately
// simplified and tilted so they read as ink on paper — emoji flags would break
// the aesthetic. Keyed by ISO-3166 alpha-2, plus 'SCT' for Scotland.
// Used by both the race journal rows and the travel polaroids.
export type CountryCode = 'FR' | 'IT' | 'CA' | 'JP' | 'US' | 'PT' | 'ES' | 'GB' | 'SCT';

interface Props {
  country: CountryCode;
  /** Rendered width in px; height follows the 36:26 viewBox. */
  width?: number;
  class?: string;
}

const { country, width = 23, class: className } = Astro.props;
const height = Math.round((width * 26) / 36);

const NAMES: Record<CountryCode, string> = {
  FR: 'France',
  IT: 'Italy',
  CA: 'Canada',
  JP: 'Japan',
  US: 'United States',
  PT: 'Portugal',
  ES: 'Spain',
  GB: 'United Kingdom',
  SCT: 'Scotland',
};
---

<svg
  width={width}
  height={height}
  viewBox="0 0 36 26"
  class={className}
  role="img"
  aria-label={NAMES[country]}
>
  {
    country === 'FR' && (
      <>
        <rect x="2" y="3" width="10" height="20" fill="#3a5a9a" opacity=".8" transform="rotate(-1 18 13)" />
        <rect x="12" y="3" width="10" height="20" fill="#f6efdd" transform="rotate(-1 18 13)" />
        <rect x="22" y="3" width="10" height="20" fill="#c1442e" opacity=".8" transform="rotate(-1 18 13)" />
      </>
    )
  }
  {
    country === 'IT' && (
      <>
        <rect x="2" y="3" width="10" height="20" fill="#3d8f4f" opacity=".8" transform="rotate(-1 18 13)" />
        <rect x="12" y="3" width="10" height="20" fill="#f6efdd" transform="rotate(-1 18 13)" />
        <rect x="22" y="3" width="10" height="20" fill="#c1442e" opacity=".8" transform="rotate(-1 18 13)" />
      </>
    )
  }
  {
    country === 'CA' && (
      <>
        <rect x="2" y="3" width="9" height="20" fill="#c1442e" opacity=".8" transform="rotate(-1 18 13)" />
        <rect x="11" y="3" width="12" height="20" fill="#f6efdd" transform="rotate(-1 18 13)" />
        <rect x="23" y="3" width="9" height="20" fill="#c1442e" opacity=".8" transform="rotate(-1 18 13)" />
        <path
          d="M17 8 L18.6 11 L21 10.4 L19.8 13.2 L21.6 15 L18.9 15.4 L18.7 18 L17 16 L15.3 18 L15.1 15.4 L12.4 15 L14.2 13.2 L13 10.4 L15.4 11 Z"
          fill="#c1442e"
          opacity=".85"
        />
      </>
    )
  }
  {
    country === 'JP' && (
      <>
        <rect x="2" y="3" width="30" height="20" fill="#f6efdd" stroke="#8b8271" stroke-width="1" transform="rotate(-1 18 13)" />
        <circle cx="17" cy="13" r="5.5" fill="#c1442e" opacity=".85" />
      </>
    )
  }
  {
    country === 'US' && (
      <>
        <rect x="2" y="3" width="30" height="20" fill="#f6efdd" stroke="#8b8271" stroke-width="1" transform="rotate(-1 18 13)" />
        <path d="M2 8 H32 M2 13 H32 M2 18 H32" stroke="#c1442e" stroke-width="2" opacity=".7" transform="rotate(-1 18 13)" />
        <rect x="2" y="3" width="13" height="10" fill="#3a5a9a" opacity=".82" transform="rotate(-1 18 13)" />
      </>
    )
  }
  {
    country === 'PT' && (
      <>
        <rect x="2" y="3" width="12" height="20" fill="#3d8f4f" opacity=".8" transform="rotate(-1 18 13)" />
        <rect x="14" y="3" width="18" height="20" fill="#c1442e" opacity=".8" transform="rotate(-1 18 13)" />
        <circle cx="14" cy="13" r="4" fill="#f6efdd" stroke="#5a4c34" stroke-width="1.2" />
      </>
    )
  }
  {
    country === 'ES' && (
      <>
        <rect x="2" y="4" width="30" height="6" fill="#c1442e" opacity=".8" transform="rotate(-1 18 13)" />
        <rect x="2" y="10" width="30" height="7" fill="#e0b23a" opacity=".85" transform="rotate(-1 18 13)" />
        <rect x="2" y="17" width="30" height="6" fill="#c1442e" opacity=".8" transform="rotate(-1 18 13)" />
      </>
    )
  }
  {
    country === 'GB' && (
      <>
        <rect x="2" y="3" width="30" height="20" fill="#3a5a9a" opacity=".82" transform="rotate(-1 18 13)" />
        <path d="M2 3 L32 23 M32 3 L2 23" stroke="#f6efdd" stroke-width="3.4" transform="rotate(-1 18 13)" />
        <path d="M17 3 V23 M2 13 H32" stroke="#f6efdd" stroke-width="5.4" transform="rotate(-1 18 13)" />
        <path d="M17 3 V23 M2 13 H32" stroke="#c1442e" stroke-width="2.6" transform="rotate(-1 18 13)" />
      </>
    )
  }
  {
    country === 'SCT' && (
      <>
        <rect x="2" y="3" width="30" height="20" fill="#3a5a9a" opacity=".82" transform="rotate(-1 18 13)" />
        <path d="M2 3 L32 23 M32 3 L2 23" stroke="#f6efdd" stroke-width="4" transform="rotate(-1 18 13)" />
      </>
    )
  }
</svg>

<style>
  svg {
    transform: rotate(-4deg);
    flex-shrink: 0;
  }
</style>
