---
// The live "where and when" block in the Home page header: Vancouver date,
// clock and current conditions, with one of five hand-drawn weather marks.
// All five icons ship in the markup; the script reveals the matching one.
import T from '../T.astro';
import { t } from '../../i18n';
---

<div class="dateline">
  <span class="coords"><T t={t.home.position} /></span><br />
  <T t={t.home.city} /> · <span id="jd-date"></span><br />
  <span id="jd-time"></span> — <span id="jd-weather"><T t={t.home.loadingWeather} /></span>
  <span class="wx" id="jd-icon">
    <svg data-wx="sun" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
      <path
        d="M12 2.5 V5 M12 19 V21.5 M2.5 12 H5 M19 12 H21.5 M5.3 5.3 L7 7 M17 17 L18.7 18.7 M18.7 5.3 L17 7 M7 17 L5.3 18.7"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"></path>
    </svg>
    <svg data-wx="cloud" width="28" height="24" viewBox="-1 -1 26 22" aria-hidden="true">
      <path
        d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"
        fill="var(--paper-l)"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
        stroke-linecap="round"></path>
    </svg>
    <svg data-wx="rain" width="26" height="28" viewBox="-1 -1 26 28" aria-hidden="true">
      <path
        d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"
        fill="var(--paper-l)"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
        stroke-linecap="round"></path>
      <path d="M7 22 L6 25.5 M12 22 L11 25.5 M17 22 L16 25.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
    </svg>
    <svg data-wx="snow" width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        {
          [0, 60, 120, 180, 240, 300].map((deg) => (
            <g transform={`rotate(${deg} 12 12)`}>
              <path d="M12 12 L12 3 M12 7 L8.7 3.7 M12 7 L15.3 3.7 M12 3 L10.5 4.8 M12 3 L13.5 4.8" />
            </g>
          ))
        }
      </g>
    </svg>
    <svg data-wx="storm" width="22" height="26" viewBox="0 0 24 24" class="storm" aria-hidden="true">
      <path
        d="M13 2 L5 13.5 L11 13.5 L9.5 22 L19 10 L13 10 Z"
        fill="none"
        stroke="var(--red)"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
</div>

<script>
  import { en } from '../../i18n/en';
  import { fr } from '../../i18n/fr';

  const dateEl = document.getElementById('jd-date');
  const timeEl = document.getElementById('jd-time');
  const wxEl = document.getElementById('jd-weather');
  const iconEl = document.getElementById('jd-icon');

  if (dateEl && timeEl && wxEl && iconEl) {
    const TZ = 'America/Vancouver';
    const lang = () => (document.documentElement.dataset.lang === 'fr' ? 'fr' : 'en');
    const messages = () => (lang() === 'fr' ? fr : en);

    /** Latest Open-Meteo reading, kept so a language switch can re-render it. */
    let current: { temp: number; code: number } | null = null;

    function renderClock() {
      const locale = lang() === 'fr' ? 'fr-CA' : 'en-US';
      const now = new Date();
      // "wednesday, july 24" — lowercased to sit in the handwriting.
      dateEl!.textContent = now
        .toLocaleDateString(locale, { timeZone: TZ, weekday: 'long', month: 'long', day: 'numeric' })
        .toLowerCase();
      timeEl!.textContent = now
        .toLocaleTimeString(locale, { timeZone: TZ, hour: 'numeric', minute: '2-digit', hour12: lang() !== 'fr' })
        .toLowerCase();
    }

    /** Open-Meteo WMO weather_code → one of the five drawn marks + a phrase. */
    function describe(code: number): { icon: string; text: string } {
      const w = messages().home.weather;
      if (code <= 1) return { icon: 'sun', text: w.clear };
      if (code <= 3) return { icon: 'cloud', text: code === 2 ? w.partly : w.overcast };
      if (code === 45 || code === 48) return { icon: 'cloud', text: w.fog };
      if ((code >= 71 && code <= 77) || code === 85 || code === 86) return { icon: 'snow', text: w.snow };
      if (code >= 95) return { icon: 'storm', text: w.storm };
      return { icon: 'rain', text: w.rain };
    }

    function renderWeather() {
      if (!current) return;
      const { icon, text } = describe(current.code);
      wxEl!.textContent = `${Math.round(current.temp)}°C, ${text}`;
      iconEl!.dataset.show = icon;
    }

    async function fetchWeather() {
      try {
        const res = await fetch(
          'https://api.open-meteo.com/v1/forecast?latitude=49.2827&longitude=-123.1207' +
            '&current=temperature_2m,weather_code&timezone=America%2FVancouver',
        );
        const data = (await res.json()) as { current?: { temperature_2m: number; weather_code: number } };
        if (data?.current) {
          current = { temp: data.current.temperature_2m, code: data.current.weather_code };
          renderWeather();
        }
      } catch {
        /* leave the placeholder — the page reads fine without it */
      }
    }

    renderClock();
    setInterval(renderClock, 30_000);
    window.addEventListener('langchange', () => {
      renderClock();
      renderWeather();
    });
    fetchWeather();
    setInterval(fetchWeather, 10 * 60 * 1000);
  }
</script>

<style>
  .dateline {
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.3;
    color: var(--ink-2);
    text-align: right;
    transform: rotate(-0.8deg);
  }

  .coords {
    font-family: var(--font-label);
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--gold);
  }

  .wx {
    display: inline-block;
    vertical-align: -6px;
    margin-left: 2px;
    color: var(--ink-2);
  }

  /* All five ship in the HTML; the script picks one. */
  .wx svg {
    display: none;
  }

  .wx[data-show='sun'] svg[data-wx='sun'],
  .wx[data-show='cloud'] svg[data-wx='cloud'],
  .wx[data-show='rain'] svg[data-wx='rain'],
  .wx[data-show='snow'] svg[data-wx='snow'],
  .wx[data-show='storm'] svg[data-wx='storm'] {
    display: inline-block;
  }

  .storm {
    transform: rotate(-3deg);
  }

  @media (max-width: 1060px) {
    .dateline {
      text-align: left;
    }
  }
</style>
