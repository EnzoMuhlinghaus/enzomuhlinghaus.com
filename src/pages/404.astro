---
import Layout from '../layouts/Layout.astro';
import { SITE_ORIGIN, WORKBENCH_ORIGIN } from '../data/site';

// A torn-out page, in the journal's voice, replacing Astro's unstyled default.
// Served on both hostnames, so it points at both and assumes neither.
---

<Layout
  title="Page not found — Enzo Muhlinghaus"
  description="That page isn’t in the journal. Head back to the field journal or the workbench."
  canonical={`${SITE_ORIGIN}/404`}
>
  <main class="desk">
    <div class="sheet ruled">
      <div class="tape" style="top:-14px;left:50%;margin-left:-60px;width:120px;height:30px;transform:rotate(-3deg)">
      </div>
      <div class="eyebrow">ENTRY NOT FOUND</div>
      <h1>This page got torn out.</h1>
      <p class="blurb">
        Nothing lives at that address.
      </p>
      <nav class="ways" aria-label="Where to go instead">
        <a class="hand-link" href={SITE_ORIGIN}>← back to the journal</a>
        <a class="hand-link" href={WORKBENCH_ORIGIN}>the workbench <span class="arrow-ne">→</span></a>
      </nav>
      <div class="folio">404</div>
    </div>
  </main>
</Layout>

<style>
  .desk {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    box-sizing: border-box;
    background: radial-gradient(ellipse 120% 80% at 50% -10%, var(--desk-top), var(--desk-bottom));
  }

  .sheet {
    position: relative;
    width: 100%;
    max-width: 480px;
    padding: 52px 44px 44px;
    box-sizing: border-box;
    background-color: var(--paper-l);
    border-radius: 4px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.4);
    transform: rotate(-0.8deg);
  }

  .eyebrow {
    font-family: var(--font-label);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--gold);
  }

  h1 {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 44px;
    line-height: 1.05;
    color: var(--ink);
    margin: 10px 0 0;
  }

  .blurb {
    font-family: var(--font-hand);
    font-size: 21px;
    line-height: 1.3;
    color: var(--ink-2);
    margin: 12px 0 0;
  }

  .ways {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    margin-top: 28px;
  }

  .folio {
    position: absolute;
    bottom: 16px;
    right: 24px;
    font-family: var(--font-label);
    font-size: 12px;
    color: var(--faint);
  }

  @media (max-width: 560px) {
    .sheet {
      padding: 42px 26px 36px;
    }

    h1 {
      font-size: 36px;
    }
  }
</style>
