---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import T from '../components/T.astro';
import Flag from '../components/Flag.astro';
import Page from '../components/journal/Page.astro';
import Dateline from '../components/journal/Dateline.astro';
import Polaroid from '../components/journal/Polaroid.astro';
import { journalEntries, prEntries } from '../lib/races';
import { kmThisYear } from '../lib/strava';
import { JOURNAL_ROWS, LINKS, SPREADS } from '../data/journal';
import { JOBS, TOOLBELT, DOODLE_BOXES } from '../data/work';
import { POLAROIDS_LEFT, POLAROIDS_RIGHT } from '../data/travel';
import { STRAVA_URL } from '../data/endurance';
import { SITE_ORIGIN, WORKBENCH_ORIGIN } from '../data/site';
import { t, SITE_LANG } from '../i18n';
import moi from '../assets/photos/moi.webp';
import race703 from '../assets/photos/race-703-finish.webp';
import captainWallet from '../assets/photos/captain-wallet.webp';

// The only on-demand page on the site: the Endurance spread renders live Notion
// races and a live Strava distance. Everything else stays prerendered.
export const prerender = false;

// Notion and Strava are separate upstreams, so those two go in parallel. prEntries()
// deliberately follows journalEntries() rather than joining the race: both read the
// same KV key, and going second means it finds the cache warm instead of triggering
// a duplicate Notion query on a miss.
const [races, km] = await Promise.all([journalEntries(), kmThisYear()]);
const prs = await prEntries();

// Let Cloudflare's edge hold the rendered page too, not just the data behind it.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=900');

// The journal is the page a search for Enzo by name should land on, so it carries
// the Person. `sameAs` reuses LINKS rather than restating the profile URLs.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Enzo Muhlinghaus',
    url: SITE_ORIGIN,
    jobTitle: 'Senior Software Engineer',
    description:
      'Senior software engineer with 9+ years designing and scaling distributed systems, and an endurance athlete — running, triathlon and cycling.',
    homeLocation: { '@type': 'Place', name: 'Vancouver, BC, Canada' },
    nationality: { '@type': 'Country', name: 'France' },
    sameAs: [LINKS.linkedin, LINKS.github, LINKS.instagram, STRAVA_URL],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Enzo Muhlinghaus — Field Journal',
    url: SITE_ORIGIN,
    inLanguage: 'en',
    author: { '@type': 'Person', name: 'Enzo Muhlinghaus' },
  },
];
---

<Layout
  title="Enzo Muhlinghaus — Field Journal"
  description="The field journal of Enzo Muhlinghaus: a Frenchman in Vancouver. Race journal, engineering notes, travels, and a workbench of small running tools."
  canonical={`${SITE_ORIGIN}/`}
  jsonLd={jsonLd}
>
  <div id="shell">
    <div id="stage">
      <!-- Edge tabs live outside the book: the book clips its own fold bleed,
           and anything inside it would be clipped with it. -->
      <nav id="tabs" aria-label="Journal sections">
        {
          SPREADS.map((slug, i) => (
            <button type="button" class="tab" data-go={i} style={`--i:${i}`}>
              <span><T t={t.home.tabs[slug]} /></span>
            </button>
          ))
        }
      </nav>

      <div id="book" data-spread="0">
      {/* ============ SPREAD 1 — contents ============ */}
      <Page index={0} side="l" folio="01" label="Home, left page">
        <div class="head head--home">
          <div class="eyebrow"><T t={t.home.volume} /></div>
          <Dateline />
        </div>

        <div class="hero">
          <h1 class="display">Enzo</h1>
          <div class="scrap">
            <div class="scrap-title"><T t={t.home.sayHi} /></div>
            <div class="scrap-links">
              <a href={LINKS.email} class="stamp-link">EMAIL</a>
              <a href={LINKS.linkedin} target="_blank" rel="noopener" class="stamp-link">LINKEDIN</a>
              <a href={LINKS.cv} download class="stamp-link">CV ⤓</a>
            </div>
          </div>
        </div>
        <p class="tagline"><T t={t.home.tagline} /></p>

        <figure class="print">
          <div class="mount print-mount">
            <div class="print-frame">
              {/* Above the fold and the LCP element: `eager` is load-bearing, not
                  decoration — Astro defaults to lazy, which cancels fetchpriority. */}
              <Image
                src={moi}
                alt="Enzo, mid-adventure"
                width={900}
                fetchpriority="high"
                loading="eager"
              />
            </div>
          </div>
          <div class="tape" style="top:-13px;left:44px;width:110px;height:30px;transform:rotate(-6deg)"></div>
          <div class="tape" style="bottom:-11px;right:56px;width:110px;height:30px;transform:rotate(5deg)"></div>
          <figcaption class="me">
            <span><T t={t.home.meLabel} /></span>
            <svg width="34" height="46" viewBox="0 0 34 46" aria-hidden="true">
              <path d="M26 2 C16 14, 12 26, 15 40" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
              <path d="M8 32 L15 40 L22 33" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </figcaption>
        </figure>
      </Page>

      <Page index={0} side="r" folio="02" label="Home, right page">
        <div class="entries">
          {
            JOURNAL_ROWS.map((row) => (
              <button type="button" class="entry" data-go={SPREADS.indexOf(row.target)}>
                <div class="thumb" style={`transform:rotate(${row.rot}deg)`}>
                  <div class="thumb-frame">
                    {row.photo ? (
                      <Image
                        src={row.photo}
                        alt={row.alt}
                        width={320}
                        loading="lazy"
                        style={[
                          `object-position:${row.crop.position}`,
                          row.crop.scale
                            ? `transform:scale(${row.crop.scale});transform-origin:${row.crop.origin ?? row.crop.position}`
                            : '',
                        ]
                          .filter(Boolean)
                          .join(';')}
                      />
                    ) : (
                      <div class="photo-empty" aria-hidden="true" />
                    )}
                  </div>
                  {row.tapes.map((s) => (
                    <div class="tape" style={s} />
                  ))}
                </div>
                <div class="entry-text">
                  <div class="entry-no">{row.no}</div>
                  <div class="entry-title">{row.title}</div>
                  <div class="entry-kicker">{row.kicker}</div>
                  <div class="entry-blurb" style={`transform:rotate(${row.blurbRot}deg)`}>
                    {row.blurb}
                  </div>
                </div>
              </button>
            ))
          }
          <div class="entry entry--todo">
            <div class="thumb thumb--todo"><span>?</span></div>
            <div class="entry-text">
              <div class="entry-no">entry 04</div>
              <div class="entry-title entry-title--todo">to be continued…</div>
              <div class="entry-blurb entry-blurb--todo">more entries still in the works</div>
            </div>
          </div>
        </div>
        <div class="page-nav page-nav--end">
          <button type="button" class="hand-link" data-go="1"><T t={t.home.turnPage} /></button>
        </div>
      </Page>

      {/* ============ SPREAD 2 — Endurance ============ */}
      <Page index={1} side="l" folio="03" label="Endurance, left page">
        <div class="head">
          <div class="eyebrow"><T t={t.endurance.eyebrow} /></div>
          <div class="kicker"><T t={t.endurance.kicker} /></div>
        </div>
        <div class="title-row">
          <h2 class="display display--spread"><T t={t.endurance.title} /></h2>
          <a href={STRAVA_URL} target="_blank" rel="noopener" class="stamp-link">STRAVA ↗</a>
        </div>
        <p class="lede lede--endurance"><T t={t.endurance.blurb} /></p>

        <p class="km">
          <span class="km-figure"
            >{km.figure} km<svg class="km-circle" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"
              ><ellipse cx="50" cy="50" rx="48" ry="42" fill="none" stroke="var(--red)" stroke-width="3" opacity=".8" transform="rotate(-2 50 50)"
              ></ellipse></svg
            ></span
          >
          {/* Interpolated, so it takes the language directly rather than <T>. */}
          {t.endurance.kmSuffix[SITE_LANG](km.year)}
        </p>

        <div class="pbs">
          <div class="label"><T t={t.endurance.pbTitle} /></div>
          {
            prs.map((p) => (
              <div class:list={['leader', 'pb', { 'pb--soon': !p.time }]}>
                <span class="pb-event">
                  <T t={t.endurance.prDistances[p.distance]} />
                </span>
                <span class="leader__fill" />
                <span class="pb-time">{p.time ?? <T t={t.endurance.soon} />}</span>
              </div>
            ))
          }
        </div>

        {/* The workbench is its own site now, so this leaves the journal — hence
            absolute, and a new tab, matching how the design treats every other
            off-site link (Strava, GitHub, LinkedIn, Instagram). */}
        <a href={WORKBENCH_ORIGIN} target="_blank" rel="noopener" class="wbcard">
          <div class="tape" style="top:-12px;left:50%;margin-left:-55px;width:110px;height:28px;transform:rotate(-2deg)"></div>
          <div class="wbcard-head">
            <span><T t={t.endurance.workbenchTitle} /></span>
            <span class="wbarrow">➝</span>
          </div>
          <div class="wbcard-list">
            <div><strong>Pace Calculator</strong> <span>splits &amp; race pace</span></div>
            <div><strong>Race Predictor</strong> <span>one result, the rest</span></div>
            <div><strong>MAS / VO₂max Estimator</strong> <span>measure the engine</span></div>
          </div>
        </a>

        <figure class="race-shot">
          <figcaption class="race-shot-note">
            <span><T t={t.endurance.firstHalfIron} /> <Flag country="IT" width={30} class="inline-flag" /></span>
            <svg width="44" height="30" viewBox="0 0 52 34" aria-hidden="true">
              <path d="M4 6 C16 18, 30 23, 46 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
              <path d="M38 13 L46 20 L38 27" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </figcaption>
          <div class="race-shot-frame">
            <div class="mount">
              <Image
                src={race703}
                alt="Crossing the line at IRONMAN 70.3 Emilia-Romagna"
                width={400}
                loading="lazy"
                class="race-shot-img"
              />
            </div>
            <div class="tape" style="top:-11px;left:8px;width:72px;height:24px;transform:rotate(-5deg)"></div>
          </div>
        </figure>

        <div class="page-nav">
          <button type="button" class="hand-link hand-link--back" data-go="0"><T t={t.home.back} /></button>
        </div>
      </Page>

      <Page index={1} side="r" folio="04" label="Endurance, right page">
        <div class="head head--journal">
          <div class="eyebrow"><T t={t.endurance.journalTitle} /></div>
          <div class="count">
            {t.endurance.racesCount[SITE_LANG](races.length)}
          </div>
        </div>
        <div class="race-scroll">
          {
            races.map((race) => (
              <div class="race">
                <div class="race-day">{race.day}</div>
                <div class="race-main">
                  <div class="race-name">{race.name}</div>
                  <div class="race-meta">
                    {race.meta}
                    {race.country && <Flag country={race.country} width={18} />}
                  </div>
                </div>
                <div class="race-result">
                  {race.training ? (
                    <span class="up-next">
                      <T t={t.endurance.upNext} />
                    </span>
                  ) : (
                    <span class="race-time">
                      {race.time}
                      {race.pr && <span class="pr">PR!</span>}
                    </span>
                  )}
                  {race.rankLabel && <div class="race-rank">{race.rankLabel}</div>}
                </div>
              </div>
            ))
          }
        </div>
        <div class="page-nav page-nav--end">
          <button type="button" class="hand-link" data-go="2"><T t={t.home.turnPage} /></button>
        </div>
      </Page>

      {/* ============ SPREAD 3 — Work ============ */}
      <Page index={2} side="l" folio="05" label="Work, left page">
        <div class="head">
          <div class="eyebrow"><T t={t.work.eyebrow} /></div>
          <div class="kicker"><T t={t.work.kicker} /></div>
        </div>
        <div class="title-row">
          <h2 class="display display--spread"><T t={t.work.title} /></h2>
          <span class="title-links">
            <a href={LINKS.github} target="_blank" rel="noopener" class="stamp-link">GITHUB ↗</a>
            <a href={LINKS.linkedin} target="_blank" rel="noopener" class="stamp-link">LINKEDIN ↗</a>
            <a href={LINKS.email} class="stamp-link">EMAIL ✉</a>
          </span>
        </div>
        <p class="lede lede--work"><T t={t.work.blurb} /></p>

        <a href={LINKS.cv} download class="cvcard">
          <div class="tape" style="top:-16px;right:24px;width:90px;height:26px;transform:rotate(3deg)"></div>
          <div class="cvcard-title"><T t={t.work.resumeTitle} /></div>
          <div class="cvcard-blurb"><T t={t.work.resumeBlurb} /> <span class="dl">⤓</span></div>
        </a>

        <div class="career">
          <div class="label"><T t={t.work.careerTitle} /></div>
          {
            JOBS.map((job) => (
              <div class="job">
                <span class="job-years">{job.years}</span>
                <span class="job-main">
                  <span class="job-role">{job.role}</span>
                  <span class="job-place">{job.place}</span>
                </span>
              </div>
            ))
          }
        </div>

        <p class="toolbelt"><T t={t.work.toolbeltLabel} /> <strong>{TOOLBELT}</strong></p>

        <div class="page-nav">
          <button type="button" class="hand-link hand-link--back" data-go="1"><T t={t.home.back} /></button>
        </div>
      </Page>

      <Page index={2} side="r" folio="06" label="Work, right page">
        <div class="head head--tight">
          <div class="eyebrow"><T t={t.work.fieldNotes} /></div>
        </div>

        <figure class="note-photo">
          <figcaption class="note-caption">
            <span><T t={t.work.photoCaption} /></span>
            <svg width="64" height="44" viewBox="0 0 52 34" aria-hidden="true">
              <path d="M4 6 C16 18, 30 23, 46 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
              <path d="M38 13 L46 20 L38 27" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </figcaption>
          <div class="note-shot">
            <div class="mount">
              <Image
                src={captainWallet}
                alt="The Captain Wallet office in Paris, 2019"
                width={600}
                loading="lazy"
                class="note-frame"
              />
            </div>
            <div class="tape" style="top:-11px;left:12px;width:72px;height:24px;transform:rotate(-5deg)"></div>
            <div class="tape" style="bottom:-9px;right:16px;width:72px;height:24px;transform:rotate(4deg)"></div>
          </div>
        </figure>

        {/* A faded pencil sketch of a generic event pipeline — deliberately not a
            real system diagram, just the shape of the work. */}
        <div class="doodle" aria-hidden="true">
          {
            DOODLE_BOXES.map((b) => (
              <div class:list={['dbox', `dbox--${b.shape}`]} style={b.style}>
                <div class="dbox-title">{b.title}</div>
                <div class="dbox-sub">{b.sub}</div>
              </div>
            ))
          }
          <svg class="darrow" style="top:34px;left:41%;transform:rotate(3deg)" width="72" height="34" viewBox="0 0 72 34">
            <path d="M4 12 C24 22, 44 22, 62 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
            <path d="M54 10 L62 16 L53 22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <svg class="darrow" style="top:122px;right:26%" width="40" height="50" viewBox="0 0 40 52">
            <path d="M20 4 C14 18, 15 32, 20 44" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
            <path d="M12 37 L20 44 L27 36" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <svg class="darrow" style="top:222px;left:22%;transform:rotate(-6deg)" width="66" height="38" viewBox="0 0 70 40">
            <path d="M64 10 C44 22, 28 26, 10 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
            <path d="M18 17 L10 24 L19 31" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <svg class="darrow" style="top:256px;right:24%;transform:rotate(8deg)" width="42" height="52" viewBox="0 0 44 56">
            <path d="M14 4 C24 18, 28 32, 24 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
            <path d="M15 41 L24 48 L31 39" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <div class="dnote dnote--rust" style="top:90px;right:2px;transform:rotate(-4deg)">at-least-once ⇒ idempotent</div>
          <div class="dnote dnote--dlq" style="top:180px;left:394px;right:0;transform:rotate(2deg)">failed? → DLQ, replay later</div>
          <div class="dcross" style="top:356px;left:2px;transform:rotate(-3deg)">
            <span class="dcross-box">
              cron polling
              <svg viewBox="0 0 100 40" preserveAspectRatio="none">
                <path d="M4 6 L96 34 M96 6 L4 34" fill="none" stroke="var(--rust)" stroke-width="3" stroke-linecap="round"></path>
              </svg>
            </span>
            <span class="dcross-nope">nope.</span>
          </div>
        </div>

        <div class="page-nav page-nav--end">
          <button type="button" class="hand-link" data-go="3"><T t={t.home.turnPage} /></button>
        </div>
      </Page>

      {/* ============ SPREAD 4 — Travel ============ */}
      <Page index={3} side="l" folio="07" label="Travel, left page">
        <div class="head head--travel">
          <div class="eyebrow"><T t={t.travel.eyebrow} /></div>
          <div class="kicker"><T t={t.travel.kicker} /></div>
        </div>
        <div class="title-row title-row--travel">
          <h2 class="display display--travel"><T t={t.travel.title} /></h2>
          <a href={LINKS.instagram} target="_blank" rel="noopener" class="stamp-link">INSTAGRAM ↗</a>
        </div>
        <p class="lede lede--travel"><T t={t.travel.blurb} /></p>
        <p class="lede lede--sub"><T t={t.travel.subBlurb} /></p>

        <div class="stack">
          {POLAROIDS_LEFT.map((p) => <Polaroid polaroid={p} />)}
        </div>

        <div class="page-nav">
          <button type="button" class="hand-link hand-link--back" data-go="2"><T t={t.home.back} /></button>
        </div>
      </Page>

      <Page index={3} side="r" folio="08" label="Travel, right page">
        <div class="stack stack--full">
          {POLAROIDS_RIGHT.map((p) => <Polaroid polaroid={p} />)}
        </div>
        <div class="page-nav page-nav--end">
          <button type="button" class="hand-link" data-go="0"><T t={t.home.backHome} /></button>
        </div>
      </Page>
      </div>
    </div>
  </div>
</Layout>

<script>
  // From data/spreads.ts, not data/journal.ts: importing the latter here would
  // pull its astro:assets image imports into the client bundle.
  import { SPREADS } from '../data/spreads';

  const book = document.getElementById('book');
  const pages = [...document.querySelectorAll<HTMLElement>('.page')];
  const tabs = [...document.querySelectorAll<HTMLElement>('.tab')];

  if (book && pages.length) {
    const LAST = SPREADS.length - 1;
    // Phase 1 folds the outgoing page away; at PHASE_MS the spread flips and
    // phase 2 folds the incoming one in. Matches the two CSS animations.
    const PHASE_MS = 275;
    const SETTLE_MS = 580;
    // How long the book rests on Home before turning to a deep-linked spread.
    const INTRO_MS = 420;

    let spread = 0;
    let turning: 'fwd' | 'back' | null = null;
    let timers: ReturnType<typeof setTimeout>[] = [];
    let intro: ReturnType<typeof setTimeout> | null = null;

    /** Which visual role each page plays right now. CSS does the rest. */
    function paint(from: number, to: number, phase: 0 | 1 | 2) {
      for (const page of pages) {
        const i = Number(page.dataset.index);
        const side = page.dataset.side;
        let role = '';

        if (phase === 0) {
          if (i === spread) role = side!;
        } else if (turning === 'fwd') {
          if (phase === 1) {
            if (i === from && side === 'l') role = 'l';
            else if (i === to && side === 'r') role = 'r-under';
            else if (i === from && side === 'r') role = 'fold-out-r';
          } else {
            if (i === to && side === 'r') role = 'r';
            else if (i === from && side === 'l') role = 'l-under';
            else if (i === to && side === 'l') role = 'fold-in-l';
          }
        } else {
          if (phase === 1) {
            if (i === from && side === 'r') role = 'r';
            else if (i === to && side === 'l') role = 'l-under';
            else if (i === from && side === 'l') role = 'fold-out-l';
          } else {
            if (i === to && side === 'l') role = 'l';
            else if (i === from && side === 'r') role = 'r-under';
            else if (i === to && side === 'r') role = 'fold-in-r';
          }
        }

        if (role) page.dataset.role = role;
        else delete page.dataset.role;
      }
    }

    /** A tab sits on the left spine once its spread has been passed. */
    function paintTabs() {
      tabs.forEach((tab, i) => {
        tab.dataset.pos = i <= spread ? 'l' : 'r';
        tab.setAttribute('aria-current', i === spread ? 'true' : 'false');
      });
      book!.dataset.spread = String(spread);
    }

    function turn(target: number, fromHash = false) {
      if (turning || target === spread || target < 0 || target > LAST) return;
      const from = spread;
      turning = target > spread ? 'fwd' : 'back';
      paint(from, target, 1);
      if (!fromHash) history.pushState(null, '', '#' + SPREADS[target]);

      timers.push(
        setTimeout(() => {
          spread = target;
          paint(from, target, 2);
          paintTabs();
        }, PHASE_MS),
      );
      timers.push(
        setTimeout(() => {
          turning = null;
          paint(from, target, 0);
        }, SETTLE_MS),
      );
    }

    /** Jump with no animation — used for the initial hash and for reduced motion. */
    function jump(target: number) {
      timers.forEach(clearTimeout);
      timers = [];
      turning = null;
      spread = target;
      paint(target, target, 0);
      paintTabs();
    }

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Mirrors the stacked breakpoint in Page.astro, below which the fold is
    // switched off and a turn is a bare content swap.
    const folds = window.matchMedia('(min-width: 1061px)');

    /** Drop the pending opening turn — any real navigation outranks it. */
    function cancelIntro() {
      if (intro !== null) {
        clearTimeout(intro);
        intro = null;
      }
    }

    // Stacked, there is no fold to watch: Page.astro sets `animation: none`, so
    // turn()'s two phases spend ~580ms showing the spread you just left before
    // the content swaps. Nothing is animating in that window — it is pure delay,
    // so jump straight there. `.matches` is live, so this stays right across a
    // resize even though neither query carries a change listener.
    const instant = () => reduced.matches || !folds.matches;

    const go = (target: number, fromHash = false) => {
      cancelIntro();
      if (instant()) {
        if (target !== spread && !fromHash) history.pushState(null, '', '#' + SPREADS[target]);
        jump(target);
      } else {
        turn(target, fromHash);
      }
    };

    const fromHash = () => {
      const i = SPREADS.indexOf(location.hash.slice(1) as (typeof SPREADS)[number]);
      return i >= 0 ? i : 0;
    };

    // Any element carrying data-go navigates: tabs, entry rows, page links.
    document.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-go]');
      if (el) go(Number(el.dataset.go));
    });

    window.addEventListener('hashchange', () => go(fromHash(), true));

    document.addEventListener('keydown', (e) => {
      if (/INPUT|TEXTAREA|SELECT/.test((e.target as HTMLElement)?.tagName ?? '')) return;
      if (e.key === 'ArrowRight') go(Math.min(LAST, spread + 1));
      else if (e.key === 'ArrowLeft') go(Math.max(0, spread - 1));
    });

    // A deep link (#endurance) should still open like a book rather than
    // already being held open: land on Home, let it settle, then turn to the
    // requested spread. Skipped when there is no fold to watch — reduced
    // motion, or the stacked layout, where it would only flash Home's content.
    const landing = fromHash();
    const opening = landing !== 0 && !reduced.matches && folds.matches;

    jump(opening ? 0 : landing);

    if (opening) {
      intro = setTimeout(() => {
        intro = null;
        turn(landing, true);
      }, INTRO_MS);
    }
  }
</script>

