---
import Layout from '../../layouts/Layout.astro';
import Workbench from '../../components/tools/Workbench.vue';
---

<Layout
  title="The Workbench — Enzo Muhlinghaus"
  description="Small running tools built for my own training: pace calculator, race predictor, MAS/VO2max estimator and a Strava namer. All on one bench."
>
  <div class="bench-page">
    <Workbench client:load />
  </div>
</Layout>

<style>
  /* One dark bench holding the whole toolbox — no page-turns, no nav chrome. */
  .bench-page {
    min-height: 100vh;
    background: radial-gradient(ellipse 120% 80% at 50% -10%, var(--bench-top), var(--bench-bottom));
    padding: 34px 30px 64px;
    box-sizing: border-box;
  }
</style>
