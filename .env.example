# Copy to .env and fill in. LOCAL DEVELOPMENT ONLY — `npm run dev` and
# `npm run preview` read this to render the live Endurance data.
#
# `npm run build` does NOT need any of it: nothing is fetched at build time, so
# the deploy pipeline runs with no credentials at all. In production these are
# Cloudflare Worker secrets (`npx wrangler secret put <NAME>`), read at request
# time. All are server-side only and never shipped to the client.

# Notion: the race journal + PR blackboard (src/lib/races.ts).
NOTION_TOKEN=
NOTION_DB_ID=

# Strava: the "N km run so far this year" figure (src/lib/strava.ts).
# STRAVA_REFRESH_TOKEN comes from a one-time OAuth authorization — see the
# "Live data" section of CLAUDE.md for how to regenerate it.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
